<% layout("Layouts/boilerplate") %>

<body>
   <div class="row">
    <div class="col-6 offset-2">
       <div class="card" style="width: 18rem;">
       <img class="card-img-top" src="<%= info.image.url %>" alt="Card image cap">
      <div class="card-body">
    <h5 class="card-title mt-2"> <%= info.title  %> </h5>
    <!-- <p class="card-text"> -->
      <p>
        <%= info.description  %> <br>
        <%= info.price.toLocaleString("en-BD")  %> <br>
        <%= info.location  %> <br>
        <%= info.country  %>
      </p>
  </div>
  <div class="row">
      <div class="col-4">
        <form method="get" action="/listings/<%= info._id %>/edit">
    <button class="btn btn-dark">Edit</button>
    </form>
    </div>
    <div class="col-8">
    <form method="post" action="/listings/<%= info._id  %>/delete?_method=DELETE">
      <button class="btn btn-dark">Delete </button>
    </form>
  </div>

   
     
  </div>
  </div>
  <hr>
  <div  class=" Review col-12 mt-4">
    <h4>Leave a review</h4>
    <form method="post" action="/listings/<%= info._id %>/review"  novalidate class="needs-validation" >
      <div class="rating mb-3 mt-3">
      <label class="form-label" for="rating">Rating</label>
      <input class="form-range" min="1" max="5" type="range" name="review[rating]" id="">
     </div>
     <div class="comment mb-3 mt-3 ">
        <label class="form-label" for="comment">Comments
        </label>
        <textarea required cols="30" rows="5" class="form-control" name="review[comment]" id=""></textarea>
        <div class="invalid-feedback">Please add any comment</div>
     </div>
     <button class="btn btn-outline-dark">Submit</button>
    </form><br>
    <h4>All Reviews</h4><br>

    <div class="row">
      <% for(let review of info.reviews)  { %>
        <div class="card col-5 ms-3 mb-3 ">
          <div class="body">
            <h3 class="card-title" > sourav
            </h3>
            <p  class="card-text" > <%= review.comment  %> </p>
            <p class="card-title" > <%= review.rating %> stars  </p>
          </div>

          <form method="post" action="/listings/<%= info._id  %>/review/<%= review._id %>?_method=DELETE">
           <button class="btn btn-dark btn-sm" >Delete</button>
          </form>

        </div>
      <% } %>

    </div>
    
   </div>
  </div>
</div>

</body>
