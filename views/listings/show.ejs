<% layout("Layouts/boilerplate") %>

<body>
   <div class="row">
    <div class="col-6 offset-4">
       <div class="card" style="width: 18rem;">
       <img class="card-img-top" src="<%= info.image.url %>" alt="Card image cap">
      <div class="card-body">
    <h5 class="card-title mt-2"> <%= info.title  %> </h5>
    <!-- <p class="card-text"> -->
      <p>
        <i>Owned By <%= info.owner ? info.owner.username : "Unknown" %></i> <br>
        <%= info.description  %> <br>
        <%= info.price.toLocaleString("en-BD")  %> <br>
        <%= info.location  %> <br>
        <%= info.country  %>
      </p>
  </div>

  <div class="row">
   
      <div class="col-4">
        <form method="get" action="/listings/<%= info._id %>/edit">
        <button class="btn btn-dark">Edit</button>
    </form>
    </div>
    <div class="col-8">
    <form method="post" action="/listings/<%= info._id  %>/delete?_method=DELETE">
      <button class="btn btn-dark">Delete </button>
    </form>
   
  </div>
  </div>


   
     
  </div>
  </div>
  
  <div  class=" Review col-8 mt-4">
    <hr>
    <% if(currUser) { %>
    <h4>Leave a review</h4>
    <form method="post" action="/listings/<%= info._id %>/review"  novalidate class="needs-validation" >
      <div class="rating mb-3 mt-3">
      <label class="form-label" for="rating">Rating</label>
  <fieldset class="starability-slot">
 
  <input type="radio" id="no-rate" class="input-no-rate" name="review[rating]" value="0" checked aria-label="No rating." />
  <input type="radio" id="first-rate1" name="review[rating]" value="1" />
  <label for="first-rate1" title="Terrible">1 star</label>
  <input type="radio" id="first-rate2" name="review[rating]" value="2" />
  <label for="first-rate2" title="Not good">2 stars</label>
  <input type="radio" id="first-rate3" name="review[rating]" value="3" />
  <label for="first-rate3" title="Average">3 stars</label>
  <input type="radio" id="first-rate4" name="review[rating]" value="4" />
  <label for="first-rate4" title="Very good">4 stars</label>
  <input type="radio" id="first-rate5" name="review[rating]" value="5" />
  <label for="first-rate5" title="Amazing">5 stars</label>
</fieldset>
    
     <div class="comment mb-3 mt-3 ">
        <label class="form-label" for="comment">Comments
        </label>
        <textarea required cols="30" rows="5" class="form-control" name="review[comment]" id=""></textarea>
        <div class="invalid-feedback">Please add any comment</div>
     </div>
     <button class="btn btn-outline-dark">Submit</button>
    </form><br>
   <% } %>
    <h4>All Reviews</h4><br>

    <div class="row">
      <% for(let review of info.reviews)  { %>
        <div class="card col-5 ms-3 mb-3 ">
          <div class="card-body">
            <h3 class="card-title" > @ <%= review.author.username  %>
            </h3>
            <p  class="card-text" > <%= review.comment  %> </p>
           <p class="starability-result" data-rating="<%= review.rating %>">
            Rated: <%= review.rating %> stars
          </p>
          <form method="post" action="/listings/<%= info._id  %>/review/<%= review._id %>?_method=DELETE">
            <button class="btn btn-dark btn-sm" >Delete</button>
            </form>
        </div>
    

            
        </div>

      <% } %>

  </div>
  </div>
  </div>
</div>

</body>
